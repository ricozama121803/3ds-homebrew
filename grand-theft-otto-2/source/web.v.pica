; Vertex shader for Sunset Ops. All lighting is baked into the vertex colours by scene.c, so this transforms, and computes distance haze.
; PICA200 note: only the FIRST source operand of an instruction may be a uniform, so uniforms are written first.
.fvec projection[4]      ; from citro3d (includes the screen tilt and the stereo offset)
.fvec modelView[4]       ; rows of the world -> view matrix (rigid)
.fvec fogp               ; x = -1 / (end - start), y = -start / (end - start)
.fvec fogsel             ; x = 1: replace the colour alpha with the haze amount (the texture environment then blends the haze colour in), 0: keep alpha

.constf k0(0.0, 1.0, 0.5, 0.0)
.alias zeros k0.xxxx
.alias ones k0.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.in inpos v0
.in intc v1
.in inclr v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	mov r1.w, ones
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mov outtc0, intc

	; haze amount f = clamp((depth - start) / (end - start))^2, depth = -view z
	mul r3.x, fogp.x, r1.z
	add r3.x, fogp.y, r3.x
	max r3.x, zeros, r3.x
	min r3.x, ones, r3.x
	mul r3.x, r3.x, r3.x
	; colour alpha = alpha + fogsel * (f - alpha)
	mov r5, inclr
	add r6.x, r3.x, -r5.w
	mul r6.x, fogsel.x, r6.x
	add r5.w, r5.w, r6.x
	mov outclr, r5
	end
.end
