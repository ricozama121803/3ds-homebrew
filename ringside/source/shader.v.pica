; Per-vertex lighting for Ringside. Mirrored exactly by shade() in host/gfx_host.c - keep them in sync.
;
; PICA200 note: only the FIRST source operand of an instruction may be a uniform/constant register, so
; uniforms are always written first.

; ---- uniforms (all light vectors are in view space, set per eye by gfx_3ds.c)
.fvec projection[4]      ; from citro3d (includes the screen tilt and the stereo offset)
.fvec modelView[4]       ; rows of the (rigid) model-view matrix
.fvec L0, L1             ; directions towards the key / back light
.fvec C0, C1             ; their colours
.fvec gndC, hemiD        ; hemisphere ambient: ground colour and (sky - ground)
.fvec upV                ; world "up" in view space
.fvec pPos, pCol         ; point light (position in view space, colour)
.fvec pInv               ; x = 1 / range^2
.fvec matBase            ; rgb = base colour, a = alpha
.fvec matParm            ; x = specular, y = diffuse wrap, z = rim strength
.fvec outl               ; x = outline width: vertices are pushed out along their normal (drawn with front faces culled)

; ---- constants
.constf k0(0.0, 1.0, 0.5, 0.4)
.constf k1(0.000001, 0.0, 0.0, 0.0)
.alias  zeros k0.xxxx
.alias  ones  k0.yyyy
.alias  half  k0.zzzz
.alias  rimbias k0.wwww
.alias  tiny  k1.xxxx

; ---- outputs
.out outpos position
.out outclr color

; ---- inputs
.in inpos v0
.in innrm v1
.in inclr v2                ; painted vertex tint

.proc main
	; view-space position -> r1
	mul r14.xyz, outl.xxx, innrm
	add r0.xyz, inpos, r14
	mov r0.w, ones
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	mov r1.w, ones

	; clip-space position
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; view-space normal, normalised -> r2
	dp3 r2.x, modelView[0], innrm
	dp3 r2.y, modelView[1], innrm
	dp3 r2.z, modelView[2], innrm
	dp3 r3.x, r2, r2
	rsq r3.x, r3.x
	mul r2.xyz, r2.xyz, r3.xxx

	; direction to the eye -> r4
	dp3 r3.x, r1, r1
	rsq r3.x, r3.x
	mul r4.xyz, r1.xyz, r3.xxx
	mov r4.xyz, -r4.xyz

	; wrapped diffuse for the two directional lights -> r5.xy
	dp3 r5.x, L0, r2
	dp3 r5.y, L1, r2
	mov r6, matParm
	add r5.xy, r6.yy, r5.xy
	add r7.x, ones, r6.y
	rcp r7.x, r7.x
	mul r5.xy, r5.xy, r7.xx
	max r5.xy, zeros, r5.xy

	; hemisphere ambient -> r9
	dp3 r7.x, upV, r2
	mul r7.x, half, r7.x
	add r7.x, half, r7.x
	mul r8, hemiD, r7.xxxx
	add r9, gndC, r8

	; + directional lights
	mul r10, C0, r5.xxxx
	add r9, r9, r10
	mul r10, C1, r5.yyyy
	add r9, r9, r10

	; + point light with quadratic falloff
	add r10, pPos, -r1
	dp3 r11.x, r10, r10
	add r12.x, tiny, r11.x
	rsq r12.x, r12.x
	mul r10.xyz, r10.xyz, r12.xxx
	dp3 r12.y, r10, r2
	max r12.y, zeros, r12.y
	mul r13.x, pInv, r11.xxxx
	add r13.x, ones, -r13.x
	max r13.x, zeros, r13.x
	mul r13.x, r13.x, r13.x
	mul r12.y, r12.y, r13.x
	mul r10, pCol, r12.yyyy
	add r9, r9, r10

	; base colour
	mul r9.xyz, matBase, r9
	mul r9.xyz, r9, inclr

	; specular: (n . normalize(L0 + v))^16 * spec * C0
	add r10.xyz, L0, r4
	dp3 r11.x, r10, r10
	rsq r11.x, r11.x
	mul r10.xyz, r10.xyz, r11.xxx
	dp3 r12.x, r10, r2
	max r12.x, zeros, r12.x
	mul r12.x, r12.x, r12.x
	mul r12.x, r12.x, r12.x
	mul r12.x, r12.x, r12.x
	mul r12.x, r12.x, r12.x
	mul r12.x, matParm, r12.x
	mul r10, C0, r12.xxxx
	add r9.xyz, r9, r10

	; rim: (1 - n.v)^3 * rim * C1, gated towards the back light
	dp3 r11.x, r2, r4
	max r11.x, zeros, r11.x
	add r11.x, ones, -r11.x
	mul r12.x, r11.x, r11.x
	mul r12.x, r12.x, r11.x
	mul r12.x, r6.zzzz, r12.x
	dp3 r11.y, L1, r2
	add r11.y, rimbias, r11.y
	max r11.y, zeros, r11.y
	mul r12.x, r12.x, r11.y
	mul r10, C1, r12.xxxx
	add r9.xyz, r9, r10

	min r9.xyz, ones, r9.xyz             ; saturate (the lamps are deliberately over-bright)
	mov outclr.xyz, r9.xyz
	mov outclr.w, matBase.wwww
	end
.end
